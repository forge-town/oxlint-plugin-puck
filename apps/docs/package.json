{
  "name": "@repo/docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3001",
    "build": "vite build",
    "serve": "vite preview",
    "compile": "tsc --noEmit",
    "lint": "oxlint --config ./.oxlintrc.json src/",
    "format": "oxfmt --config node_modules/@repo/oxc-formatter-config/oxfmt.json --write src/",
    "format:check": "oxfmt --config node_modules/@repo/oxc-formatter-config/oxfmt.json src/",
    "quality": "bun run compile && bun run lint && bun run format:check && bun run test -- --passWithNoTests",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@chenglou/pretext": "^0.0.8",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@repo/ui": "workspace:*",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-router": "^1.168.7",
    "@tanstack/react-start": "^1.167.12",
    "@tanstack/router-plugin": "^1.167.8",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.7.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@repo/oxc-formatter-config": "workspace:*",
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^4.0.16",
    "jsdom": "^29.0.1",
    "nitro": "3.0.260429-beta",
    "oxfmt": "^0.52.0",
    "typescript": "5.9.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.4"
  }
}
