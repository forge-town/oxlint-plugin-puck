{
  "workspaces": {
    "packages/ui": {
      "includeEntryExports": true,
      "entry": ["src/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/core": {
      "project": ["src/**/*.ts"]
    },
    "packages/rule-kit": {
      "project": ["src/**/*.ts"]
    },
    "packages/rules": {
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreDependencies": [
    "@oxlint/binding-darwin-arm64",
    "@rollup/rollup-darwin-arm64",
    "@repo/oxlint-config"
  ],
  "ignoreBinaries": ["tsx"],
  "ignore": ["**/*.stories.tsx"]
}
