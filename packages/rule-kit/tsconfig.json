{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"]
}
