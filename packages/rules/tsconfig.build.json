{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/cases/**/*.ts",
    "src/**/*.spec.ts",
    "src/test-utils.ts",
    "dist"
  ]
}
