{
  "name": "@repo/rules",
  "version": "0.0.0",
  "description": "Custom oxlint plugin rules (TypeScript source, compiled to JS)",
  "license": "MIT",
  "type": "module",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.json",
    "lint": "oxlint --config ./.oxlintrc.json src/"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@typescript-eslint/utils": "^8.42.0",
    "typescript": "5.9.2"
  }
}
