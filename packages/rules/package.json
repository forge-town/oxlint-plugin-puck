{
  "name": "@repo/rules",
  "version": "0.0.0",
  "description": "Custom oxlint plugin rules (TypeScript source, compiled to JS)",
  "license": "MIT",
  "type": "module",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.json",
    "lint": "oxlint --config ./.oxlintrc.json src/",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^25.6.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@typescript-eslint/utils": "^8.42.0",
    "eslint": "^10",
    "typescript": "5.9.2",
    "vitest": "^4.1.4"
  }
}
