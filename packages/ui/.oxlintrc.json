{
  "extends": ["../../packages/oxlint-config/.oxlintrc.json"],
  "rules": {
    "template/jsx-sort-props": "off",
    "react/jsx-handler-names": "off",
    "template-effect/no-use-effect": "off",
    "template-handler-verb/strict-jsx-handler-verb": "off",
    "template-jsx-callback/strict-jsx-callback-handler": "off",
    "template-store/no-component-handlers": "off",
    "template-types/no-explicit-unknown": "off",
    "template-vars/no-let": "off",
    "func-style": "off",
    "no-negated-condition": "off",
    "unicorn/no-negated-condition": "off",
    "unicorn/prefer-global-this": "off",
    "unicorn/no-document-cookie": "off"
  }
}
