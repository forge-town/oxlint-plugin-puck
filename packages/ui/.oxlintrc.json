{
  "extends": ["../../packages/oxlint-config/.oxlintrc.json"],
  "jsPlugins": [
    {
      "name": "puck",
      "specifier": "oxlint-plugin-puck-published"
    }
  ],
  "rules": {
    "puck/jsx-sort-props": "off",
    "react/jsx-handler-names": "off",
    "puck/no-use-effect": "off",
    "puck/strict-jsx-handler-verb": "off",
    "puck/strict-jsx-callback-handler": "off",
    "puck/no-component-handlers": "off",
    "puck/no-explicit-unknown": "off",
    "puck/no-let": "off",
    "func-style": "off",
    "no-negated-condition": "off",
    "unicorn/no-negated-condition": "off",
    "unicorn/prefer-global-this": "off",
    "unicorn/no-document-cookie": "off"
  }
}
